<div aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title-{{ lang }}-{{ project.id }}" class="modal" data-lang="{{ lang }}" id="modal-{{ lang }}-{{ project.id }}">
<div class="modal-panel">
<button class="close" aria-label="{% if lang == 'en' %}Close project{% else %}Projeyi kapat{% endif %}" onclick="closeModal()">×</button>
<div class="modal-head">
<span class="tag" style="--tag:{{ category.color }}">{{ category[lang] | escape }}</span>
<h2 id="modal-title-{{ lang }}-{{ project.id }}">{{ t.title | escape }}</h2>{% if t.intro %}<p>{{ t.intro | safe }}</p>{% endif %}
</div>
{% if t.problem or t.solution or t.impact %}<div class="detail-grid">
{% if t.problem %}<div class="detail-block"><h3>{{ portfolio.words[lang].problem }}</h3><p>{{ t.problem | safe }}</p></div>{% endif %}
{% if t.solution %}<div class="detail-block"><h3>{{ portfolio.words[lang].solution }}</h3><p>{{ t.solution | safe }}</p></div>{% endif %}
{% if t.impact %}<div class="detail-block wide"><h3>{{ portfolio.words[lang].impact }}</h3><p>{{ t.impact | safe }}</p></div>{% endif %}
</div>{% endif %}
{% if t.detailTechnologies.length %}<div class="chips" style="margin-bottom:24px">{% for tech in t.detailTechnologies %}<span class="chip">{{ tech | escape }}</span>{% endfor %}</div>{% endif %}
{% if project.gallery.length %}{% if t.galleryTitle or t.galleryIntro %}<div class="gallery-head">{% if t.galleryTitle %}<h3>{{ t.galleryTitle | escape }}</h3>{% endif %}{% if t.galleryIntro %}<p>{{ t.galleryIntro | escape }}</p>{% endif %}</div>{% endif %}
<div class="gallery">{% for image in project.gallery %}<figure class="shot" data-zoom-label="{{ portfolio.words[lang].zoom }}" onclick="zoomImage(this.querySelector('img'))"><img alt="{% if lang == 'tr' %}{{ image.altTR | escape }}{% else %}{{ image.altEN | escape }}{% endif %}" loading="lazy" src="{{ image.file | portfolioImage }}"/></figure>{% endfor %}</div>{% endif %}
{% if project.links.length %}<div class="chips">{% for link in project.links %}<a class="chip" href="{{ link.url | escape }}">{% if lang == 'tr' %}{{ link.labelTR | escape }}{% else %}{{ link.labelEN | escape }}{% endif %}</a>{% endfor %}</div>{% endif %}
<p class="project-more"><a href="{% if lang == 'en' %}/en/{% else %}/{% endif %}?skipIntro=1#deneyim">{{ "Current experience and channel figures" if lang == "en" else "Güncel deneyim ve kanal rakamları" }}</a> · <a href="#projects" data-close-project>{{ "All projects" if lang == "en" else "Tüm projeler" }}</a></p>
</div>
</div>
{{ t.legacyModalTail | default('') | safe }}
