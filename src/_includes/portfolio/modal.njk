<div aria-hidden="true" class="modal" data-lang="{{ lang }}" id="modal-{{ lang }}-{{ project.id }}">
<div class="modal-panel">
<button class="close" onclick="closeModal()">×</button>
<div class="modal-head">
<span class="tag" style="--tag:{{ category.color }}">{{ category[lang] | escape }}</span>
<h2>{{ t.title | escape }}</h2>{% if t.intro %}<p>{{ t.intro | safe }}</p>{% endif %}
</div>
{% if t.problem or t.solution or t.impact %}<div class="detail-grid">
{% if t.problem %}<div class="detail-block"><h4>{{ portfolio.words[lang].problem }}</h4><p>{{ t.problem | safe }}</p></div>{% endif %}
{% if t.solution %}<div class="detail-block"><h4>{{ portfolio.words[lang].solution }}</h4><p>{{ t.solution | safe }}</p></div>{% endif %}
{% if t.impact %}<div class="detail-block wide"><h4>{{ portfolio.words[lang].impact }}</h4><p>{{ t.impact | safe }}</p></div>{% endif %}
</div>{% endif %}
{% if t.detailTechnologies.length %}<div class="chips" style="margin-bottom:24px">{% for tech in t.detailTechnologies %}<span class="chip">{{ tech | escape }}</span>{% endfor %}</div>{% endif %}
{% if project.gallery.length %}{% if t.galleryTitle or t.galleryIntro %}<div class="gallery-head">{% if t.galleryTitle %}<h4>{{ t.galleryTitle | escape }}</h4>{% endif %}{% if t.galleryIntro %}<p>{{ t.galleryIntro | escape }}</p>{% endif %}</div>{% endif %}
<div class="gallery">{% for image in project.gallery %}<figure class="shot" data-zoom-label="{{ portfolio.words[lang].zoom }}" onclick="zoomImage(this.querySelector('img'))"><img alt="{% if lang == 'tr' %}{{ image.altTR | escape }}{% else %}{{ image.altEN | escape }}{% endif %}" loading="lazy" src="{{ image.file | portfolioImage }}"/></figure>{% endfor %}</div>{% endif %}
{% if project.links.length %}<div class="chips">{% for link in project.links %}<a class="chip" href="{{ link.url | escape }}">{% if lang == 'tr' %}{{ link.labelTR | escape }}{% else %}{{ link.labelEN | escape }}{% endif %}</a>{% endfor %}</div>{% endif %}
</div>
</div>
{{ t.legacyModalTail | default('') | safe }}
