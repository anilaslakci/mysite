<article class="blog-card" data-category="{{ item.category | escape }}"{% if item.featured %} data-featured="true"{% endif %}>
{% if item.cover %}<a href="{{ item.url }}" tabindex="-1" aria-hidden="true"><img src="{{ item.cover | escape }}" alt="" loading="lazy" width="800" height="450"></a>{% endif %}
<div class="card-body"><p class="eyebrow">{{ item.categoryInfo.name | escape }}{% if item.featured %}<span class="featured">Öne çıkan</span>{% endif %}</p><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.summary | escape }}</p><div class="card-meta"><time datetime="{{ item.publishedISO }}">{{ item.dateLabel }}</time><a href="{{ item.url }}" aria-label="{% if view.locale == 'en' %}Read {{ item.title | escape }}{% else %}{{ item.title | escape }} yazısını oku{% endif %}">Yazıyı oku <span aria-hidden="true">→</span></a></div></div></article>
